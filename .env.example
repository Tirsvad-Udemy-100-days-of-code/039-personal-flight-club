# Copy to .env at the project root and fill in real values. .env is gitignored
# - never commit it (the project's .gitignore ignores .env and .env.*, and keeps
# .env.example).

# Gitea personal access token (Settings -> Applications -> Generate New Token),
# scoped to issues and milestones only. framework/scripts/sync-project.sh
# --apply uses it against a Gitea remote. The older names SYNC_TOKEN and
# GITEA_TOKEN still work as fallbacks.
# NOT a deploy key - deploy keys authenticate git-over-SSH only, not the API.
TOKEN_FOR_GITEA_ISSUES=

# Gitea personal access token with write access to the repository: push, pull
# requests and merge. Kept apart from TOKEN_FOR_GITEA_ISSUES so the sync needs
# nothing broader.
TOKEN_FOR_GITEA_REPO=

# Personal Flight Club: needed only for a real run of the program (the tests
# read none of them). Placeholders only; the program reads them from .env.
# Sheety: the endpoint of the "prices" sheet and the Bearer token of the project
SHEETY_ENDPOINT=https://api.sheety.co/<your-id>/<your-project>/prices
SHEETY_TOKEN=

# Flight provider: "serpapi" or "mock" (the course's mock flight service)
FLIGHT_PROVIDER=mock
SERPAPI_API_KEY=
MOCK_FLIGHTS_APP_ID=
MOCK_FLIGHTS_APP_KEY=
# Optional: override the default URL of the mock flight service
# MOCK_FLIGHTS_URL=

# WhatsApp: your own number with country code, for example +441234567890
# Needs the optional extra: python -m pip install -e ".[whatsapp]"
WHATSAPP_NUMBER=
